generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                    Int                  @id @default(autoincrement())
  name                  String
  slug                  String               @unique
  status                String               @default("active")
  ownerEmail            String?              @map("owner_email")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  users                 User[]
  companies             Company[]
  customers             Customer[]
  products              Product[]
  registrationRequests  RegistrationRequest[]
  proposals             Proposal[]
  emailOutbox           EmailOutbox[]
  whatsappAutoReplies   WhatsappAutoReply[]
  occurrences           Occurrence[]
  occurrenceAttachments OccurrenceAttachment[]
  occurrenceEvents      OccurrenceEvent[]
  settings              TenantSetting[]
  sellerGoals           SellerGoal[]
  sellerGoalReminders   SellerGoalReminder[]

  @@map("tenants")
}

model User {
  id                 Int                  @id @default(autoincrement())
  tenantId           Int?                 @map("tenant_id")
  name               String
  email              String               @unique
  communicationEmail String?              @map("communication_email")
  whatsappPhone      String?              @map("whatsapp_phone")
  passwordHash       String               @map("password_hash")
  role               String
  isSuperAdmin       Boolean              @default(false) @map("is_super_admin")
  isDev              Boolean              @default(false) @map("is_dev")
  active             Boolean              @default(true)
  mustChangePassword Boolean              @default(false) @map("must_change_password")
  passwordUpdatedAt  DateTime?            @map("password_updated_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions           Session[]
  companyAssignments CompanySeller[]
  customerAssignments CustomerSeller[]
  registrationRequests RegistrationRequest[]
  proposals          Proposal[]
  proposalEvents     ProposalEvent[]       @relation("ProposalEventCreator")
  occurrences        Occurrence[]
  occurrenceEvents   OccurrenceEvent[]     @relation("OccurrenceEventCreator")
  sellerGoals        SellerGoal[]
  sellerGoalReminders SellerGoalReminder[]

  @@index([tenantId, role, active])
  @@map("users")
}

model Session {
  token     String   @id
  userId    Int      @map("user_id")
  expiresAt BigInt   @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id          Int             @id @default(autoincrement())
  tenantId    Int             @map("tenant_id")
  name        String
  legalName   String?         @map("legal_name")
  active      Boolean         @default(true)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellers     CompanySeller[]
  products    Product[]
  proposals   Proposal[]

  @@index([tenantId, active, name])
  @@map("companies")
}

model Customer {
  id                Int              @id @default(autoincrement())
  tenantId          Int              @map("tenant_id")
  legalName         String           @map("legal_name")
  tradeName         String?          @map("trade_name")
  cnpj              String
  stateRegistration String?          @map("state_registration")
  address           String?
  phone             String?
  email             String?
  formPayload       String?          @map("form_payload")
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellers           CustomerSeller[]
  proposals         Proposal[]
  occurrences       Occurrence[]

  @@unique([tenantId, cnpj])
  @@index([tenantId, active, legalName])
  @@map("customers")
}

model CustomerSeller {
  customerId Int      @map("customer_id")
  sellerId   Int      @map("seller_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([customerId, sellerId])
  @@index([sellerId])
  @@map("customer_sellers")
}

model CompanySeller {
  companyId Int     @map("company_id")
  sellerId  Int     @map("seller_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seller    User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([companyId, sellerId])
  @@index([sellerId])
  @@map("company_sellers")
}

model Product {
  id          Int            @id @default(autoincrement())
  tenantId    Int            @map("tenant_id")
  companyId   Int            @map("company_id")
  code        String
  name        String
  unit        String         @default("UN")
  price       Decimal        @default(0) @db.Decimal(14, 4)
  active      Boolean        @default(true)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalItems ProposalItem[]

  @@unique([companyId, code])
  @@index([tenantId, companyId, active, name])
  @@map("products")
}

model RegistrationRequest {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  orderNumber       Int?     @map("order_number")
  sellerId          Int      @map("seller_id")
  legalName         String   @map("legal_name")
  tradeName         String?  @map("trade_name")
  cnpj              String
  stateRegistration String?  @map("state_registration")
  address           String?
  phone             String?
  email             String?
  notes             String?
  formPayload       String?  @map("form_payload")
  status            String   @default("pendente")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller            User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, sellerId, status, createdAt])
  @@map("registration_requests")
}

model Proposal {
  id                   Int             @id @default(autoincrement())
  tenantId             Int             @map("tenant_id")
  orderNumber          Int?            @map("order_number")
  sellerId             Int             @map("seller_id")
  companyId            Int             @map("company_id")
  customerId           Int             @map("customer_id")
  orderType            String          @map("order_type")
  purchaseOrder        String?         @map("purchase_order")
  commissionPercent    Decimal         @default(0) @map("commission_percent") @db.Decimal(7, 4)
  invoiceType          String          @map("invoice_type")
  taxOperatorInvoice   Boolean         @default(false) @map("tax_operator_invoice")
  freightType          String          @map("freight_type")
  deliveryType         String          @map("delivery_type")
  scheduledDeliveryDate DateTime?      @map("scheduled_delivery_date") @db.Date
  discountPercent      Decimal         @default(0) @map("discount_percent") @db.Decimal(7, 4)
  discountOn           String?         @map("discount_on")
  paymentTerms         String          @map("payment_terms")
  notes                String?
  status               String          @default("em_analise")
  adminNotes           String?         @map("admin_notes")
  deliveryForecast     String?         @map("delivery_forecast")
  industryOrderNumber  String?         @map("industry_order_number")
  invoiceNumber        String?         @map("invoice_number")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller               User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                ProposalItem[]
  events               ProposalEvent[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, sellerId, status, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@map("proposals")
}

model ProposalItem {
  id              Int      @id @default(autoincrement())
  proposalId      Int      @map("proposal_id")
  productId       Int      @map("product_id")
  quantity        Decimal  @db.Decimal(14, 4)
  negotiatedPrice Decimal  @map("negotiated_price") @db.Decimal(14, 4)
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([productId])
  @@map("proposal_items")
}

model ProposalEvent {
  id           Int      @id @default(autoincrement())
  proposalId   Int      @map("proposal_id")
  status       String
  title        String
  notes        String?
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  creator      User?    @relation("ProposalEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([createdBy])
  @@map("proposal_events")
}

model EmailOutbox {
  id         Int       @id @default(autoincrement())
  tenantId   Int       @map("tenant_id")
  kind       String
  recipients String
  subject    String
  body       String
  attempts   Int       @default(0)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sentAt, attempts, createdAt])
  @@index([tenantId, kind, createdAt])
  @@map("email_outbox")
}

model WhatsappAutoReply {
  tenantId  Int      @map("tenant_id")
  instanceId String  @map("instance_id")
  messageId String   @map("message_id")
  remoteJid String   @map("remote_jid")
  repliedAt DateTime @map("replied_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, instanceId, messageId])
  @@index([repliedAt])
  @@map("whatsapp_auto_replies")
}

model Occurrence {
  id              Int                    @id @default(autoincrement())
  tenantId        Int                    @map("tenant_id")
  sellerId        Int                    @map("seller_id")
  customerId      Int                    @map("customer_id")
  reason          String
  description     String
  attachmentNames String?                @map("attachment_names")
  status          String                 @default("aberta")
  resolution      String?
  resolvedAt      DateTime?              @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller          User                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attachments     OccurrenceAttachment[]
  events          OccurrenceEvent[]

  @@index([tenantId, sellerId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@map("occurrences")
}

model OccurrenceAttachment {
  id           Int        @id @default(autoincrement())
  occurrenceId Int        @map("occurrence_id")
  tenantId     Int        @map("tenant_id")
  filename     String
  mimetype     String
  content      Bytes
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@index([tenantId, createdAt])
  @@map("occurrence_attachments")
}

model OccurrenceEvent {
  id           Int        @id @default(autoincrement())
  occurrenceId Int        @map("occurrence_id")
  tenantId     Int        @map("tenant_id")
  status       String
  title        String
  notes        String?
  createdBy    Int?       @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator      User?      @relation("OccurrenceEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([occurrenceId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdBy])
  @@map("occurrence_events")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model TenantSetting {
  tenantId Int      @map("tenant_id")
  key      String
  value    String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model SellerGoal {
  id                        Int      @id @default(autoincrement())
  tenantId                  Int      @map("tenant_id")
  sellerId                  Int      @map("seller_id")
  year                      Int
  month                     Int
  salesGoal                 Decimal? @map("sales_goal") @db.Decimal(14, 4)
  newCustomersGoal          Int?     @map("new_customers_goal")
  customerPositivationGoal  Decimal? @map("customer_positivation_goal") @db.Decimal(14, 4)
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller                    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerId, year, month])
  @@index([sellerId])
  @@map("seller_goals")
}

model SellerGoalReminder {
  tenantId Int      @map("tenant_id")
  sellerId Int      @map("seller_id")
  year     Int
  month    Int
  day      Int
  sentAt   DateTime @map("sent_at") @db.Timestamptz(6)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller   User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([tenantId, sellerId, year, month, day])
  @@index([sellerId])
  @@map("seller_goal_reminders")
}
