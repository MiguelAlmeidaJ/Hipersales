{
  "expo": {
    "name": "HiperSales",
    "slug": "hipersales",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-store.png",
    "scheme": "hipersales",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-store.png",
      "bundleIdentifier": "br.com.hipermix.hipersales",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.hipermix.hipersales",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#EDF5FC",
        "foregroundImage": "./assets/images/brand-mark.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#073C96",
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    }
  }
}
