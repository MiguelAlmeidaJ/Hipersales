{
  "expo": {
    "name": "HiperSales",
    "slug": "hipersales",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-store.png",
    "scheme": "hipersales",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-store.png",
      "bundleIdentifier": "br.com.hipersales",
      "buildNumber": "2",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.hipersales",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#052528",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#052528",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "gifEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#052528",
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 156
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#FF951E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o HiperSales selecione fotos para anexar às ocorrências.",
          "cameraPermission": "Permitir que o HiperSales use a câmera para anexar fotos às ocorrências.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9371591-d78e-48d4-8d42-3d8a053daf8e"
      }
    }
  }
}
