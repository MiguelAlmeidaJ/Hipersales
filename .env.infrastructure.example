# HiperSales — segredos exclusivos de infraestrutura
# Copie para .env.infrastructure e restrinja a leitura ao usuário de deploy.
# A API e o app mobile não devem carregar este arquivo.

# Conta administrativa usada somente para iniciar/provisionar o SQL Server.
SQLSERVER_ADMIN_USER=sa
HIPERSALES_DATABASE_ADMIN_PASSWORD=DEFINA_UMA_SENHA_ADMINISTRATIVA_FORTE

# Senha do PostgreSQL usado exclusivamente pela Evolution API.
EVOLUTION_DB_PASSWORD=DEFINA_UMA_SENHA_FORTE
