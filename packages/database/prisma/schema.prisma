// Schema principal do HiperSales.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Tenant {
  id                    Int                  @id @default(autoincrement())
  name                  String
  slug                  String               @unique @db.NVarChar(191)
  status                String               @default("active")
  ownerEmail            String?              @map("owner_email")
  createdAt             DateTime             @default(now()) @map("created_at") @db.DateTime2
  users                 User[]
  companies             Company[]
  customers             Customer[]
  products              Product[]
  registrationRequests  RegistrationRequest[]
  proposals             Proposal[]
  emailOutbox           EmailOutbox[]
  whatsappAutoReplies   WhatsappAutoReply[]
  occurrences           Occurrence[]
  occurrenceAttachments OccurrenceAttachment[]
  occurrenceEvents      OccurrenceEvent[]
  settings              TenantSetting[]
  sellerGoals           SellerGoal[]
  sellerGoalReminders   SellerGoalReminder[]
  pushTokens            PushToken[]
  notifications         Notification[]

  @@map("tenants")
}

model User {
  id                 Int                  @id @default(autoincrement())
  tenantId           Int                  @map("tenant_id")
  name               String
  email              String               @unique @db.NVarChar(191)
  communicationEmail String?              @map("communication_email")
  whatsappPhone      String?              @map("whatsapp_phone")
  passwordHash       String               @map("password_hash")
  role               String
  isSuperAdmin       Boolean              @default(false) @map("is_super_admin")
  isDev              Boolean              @default(false) @map("is_dev")
  active             Boolean              @default(true)
  mustChangePassword Boolean              @default(false) @map("must_change_password")
  passwordUpdatedAt  DateTime?            @map("password_updated_at") @db.DateTime2
  createdAt          DateTime             @default(now()) @map("created_at") @db.DateTime2
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions           Session[]
  companyAssignments CompanySeller[]
  customerAssignments CustomerSeller[]
  registrationRequests RegistrationRequest[]
  proposals          Proposal[]
  proposalEvents     ProposalEvent[]       @relation("ProposalEventCreator")
  occurrences        Occurrence[]
  occurrenceEvents   OccurrenceEvent[]     @relation("OccurrenceEventCreator")
  sellerGoals        SellerGoal[]
  sellerGoalReminders SellerGoalReminder[]
  pushTokens          PushToken[]
  notifications       Notification[]

  @@index([tenantId, role, active])
  @@map("users")
}

model Session {
  token     String   @id @db.NVarChar(191)
  userId    Int      @map("user_id")
  expiresAt BigInt   @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime2
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id          Int             @id @default(autoincrement())
  tenantId    Int             @map("tenant_id")
  name        String
  legalName   String?         @map("legal_name")
  active      Boolean         @default(true)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellers     CompanySeller[]
  products    Product[]
  proposals   Proposal[]

  @@index([tenantId, active, name])
  @@map("companies")
}

model Customer {
  id                Int              @id @default(autoincrement())
  tenantId          Int              @map("tenant_id")
  legalName         String           @map("legal_name") @db.NVarChar(191)
  tradeName         String?          @map("trade_name")
  cnpj              String
  stateRegistration String?          @map("state_registration")
  address           String?
  phone             String?
  email             String?
  formPayload       String?          @map("form_payload") @db.NVarChar(Max)
  active            Boolean          @default(true)
  status            String           @default("ativo") @db.NVarChar(20)
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime2
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellers           CustomerSeller[]
  proposals         Proposal[]
  occurrences       Occurrence[]

  @@unique([tenantId, cnpj])
  @@index([tenantId, active, legalName])
  @@map("customers")
}

model CustomerSeller {
  customerId Int      @map("customer_id")
  sellerId   Int      @map("seller_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([customerId, sellerId])
  @@index([sellerId])
  @@map("customer_sellers")
}

model CompanySeller {
  companyId Int     @map("company_id")
  sellerId  Int     @map("seller_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller    User    @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, sellerId])
  @@index([sellerId])
  @@map("company_sellers")
}

model Product {
  id                  Int            @id @default(autoincrement())
  tenantId            Int            @map("tenant_id")
  companyId           Int            @map("company_id")
  code                String
  name                String
  productGroup        String?        @map("product_group")
  subgroup            String?
  unit                String         @default("UN")
  brand               String?
  minimumSaleQuantity Decimal        @default(0) @map("minimum_sale_quantity") @db.Decimal(14, 4)
  weight              Decimal        @default(0) @db.Decimal(14, 4)
  ncm                 String?
  ipiPercent          Decimal        @default(0) @map("ipi_percent") @db.Decimal(7, 4)
  hasSt               Boolean        @default(false) @map("has_st")
  invoiceOrigin       String?        @map("invoice_origin")
  price               Decimal        @default(0) @db.Decimal(14, 4)
  active              Boolean        @default(true)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company             Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposalItems       ProposalItem[]

  @@unique([companyId, code])
  @@index([tenantId, companyId, active, name])
  @@map("products")
}

model RegistrationRequest {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  orderNumber       Int?     @map("order_number")
  sellerId          Int      @map("seller_id")
  legalName         String   @map("legal_name")
  tradeName         String?  @map("trade_name")
  cnpj              String
  stateRegistration String?  @map("state_registration")
  address           String?
  phone             String?
  email             String?
  notes             String?
  formPayload       String?  @map("form_payload") @db.NVarChar(Max)
  status            String   @default("pendente") @db.NVarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime2
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller            User     @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Unicidade de order_number nao nulo aplicada por indice filtrado (veja docs/database-filtered-uniques.sql).
  @@index([tenantId, sellerId, status, createdAt])
  @@map("registration_requests")
}

model Proposal {
  id                   Int             @id @default(autoincrement())
  tenantId             Int             @map("tenant_id")
  orderNumber          Int?            @map("order_number")
  sellerId             Int             @map("seller_id")
  companyId            Int             @map("company_id")
  customerId           Int             @map("customer_id")
  orderType            String          @map("order_type")
  purchaseOrder        String?         @map("purchase_order")
  commissionPercent    Decimal         @default(0) @map("commission_percent") @db.Decimal(7, 4)
  invoiceType          String          @map("invoice_type")
  taxOperatorInvoice   Boolean         @default(false) @map("tax_operator_invoice")
  freightType          String          @map("freight_type")
  deliveryType         String          @map("delivery_type")
  scheduledDeliveryDate DateTime?      @map("scheduled_delivery_date") @db.Date
  discountPercent      Decimal         @default(0) @map("discount_percent") @db.Decimal(7, 4)
  discountOn           String?         @map("discount_on")
  paymentTerms         String          @map("payment_terms")
  notes                String?
  status               String          @default("em_analise") @db.NVarChar(191)
  adminNotes           String?         @map("admin_notes")
  deliveryForecast     String?         @map("delivery_forecast")
  industryOrderNumber  String?         @map("industry_order_number")
  invoiceNumber        String?         @map("invoice_number")
  createdAt            DateTime        @default(now()) @map("created_at") @db.DateTime2
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime2
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller               User            @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company              Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                ProposalItem[]
  events               ProposalEvent[]
  // Unicidade de order_number nao nulo aplicada por indice filtrado (veja docs/database-filtered-uniques.sql).
  @@index([tenantId, sellerId, status, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@map("proposals")
}

model ProposalItem {
  id              Int      @id @default(autoincrement())
  proposalId      Int      @map("proposal_id")
  productId       Int      @map("product_id")
  quantity        Decimal  @db.Decimal(14, 4)
  negotiatedPrice Decimal  @map("negotiated_price") @db.Decimal(14, 4)
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product         Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([proposalId])
  @@index([productId])
  @@map("proposal_items")
}

model ProposalEvent {
  id           Int      @id @default(autoincrement())
  proposalId   Int      @map("proposal_id")
  status       String
  title        String
  notes        String?
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime2
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator      User?    @relation("ProposalEventCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([proposalId, createdAt])
  @@index([createdBy])
  @@map("proposal_events")
}

model EmailOutbox {
  id         Int       @id @default(autoincrement())
  tenantId   Int       @map("tenant_id")
  kind       String
  recipients String
  subject    String
  body       String @db.NVarChar(Max)
  attempts   Int       @default(0)
  sentAt     DateTime? @map("sent_at") @db.DateTime2
  claimedUntil DateTime? @map("claimed_until") @db.DateTime2
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime2
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sentAt, attempts, createdAt])
  @@index([claimedUntil])
  @@index([tenantId, kind, createdAt])
  @@map("email_outbox")
}

model WhatsappAutoReply {
  tenantId  Int      @map("tenant_id")
  instanceId String  @map("instance_id") @db.NVarChar(191)
  messageId String   @map("message_id") @db.NVarChar(191)
  remoteJid String   @map("remote_jid")
  repliedAt DateTime @map("replied_at") @db.DateTime2
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, instanceId, messageId])
  @@index([repliedAt])
  @@map("whatsapp_auto_replies")
}

model Occurrence {
  id              Int                    @id @default(autoincrement())
  tenantId        Int                    @map("tenant_id")
  sellerId        Int                    @map("seller_id")
  customerId      Int                    @map("customer_id")
  reason          String
  description     String
  attachmentNames String?                @map("attachment_names")
  status          String                 @default("aberta") @db.NVarChar(191)
  resolution      String?
  resolvedAt      DateTime?              @map("resolved_at") @db.DateTime2
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime2
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime2
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller          User                   @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments     OccurrenceAttachment[]
  events          OccurrenceEvent[]

  @@index([tenantId, sellerId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@map("occurrences")
}

model OccurrenceAttachment {
  id           Int        @id @default(autoincrement())
  occurrenceId Int        @map("occurrence_id")
  tenantId     Int        @map("tenant_id")
  filename     String
  mimetype     String
  content      Bytes
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime2
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurrenceId])
  @@index([tenantId, createdAt])
  @@map("occurrence_attachments")
}

model OccurrenceEvent {
  id           Int        @id @default(autoincrement())
  occurrenceId Int        @map("occurrence_id")
  tenantId     Int        @map("tenant_id")
  status       String
  title        String
  notes        String?
  createdBy    Int?       @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime2
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator      User?      @relation("OccurrenceEventCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurrenceId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdBy])
  @@map("occurrence_events")
}

model SystemSetting {
  key       String   @id @db.NVarChar(191)
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime2

  @@map("system_settings")
}

model TenantSetting {
  tenantId Int      @map("tenant_id")
  key      String
  value    String @db.NVarChar(Max)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime2
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model SellerGoal {
  id                        Int      @id @default(autoincrement())
  tenantId                  Int      @map("tenant_id")
  sellerId                  Int      @map("seller_id")
  year                      Int
  month                     Int
  salesGoal                 Decimal? @map("sales_goal") @db.Decimal(14, 4)
  newCustomersGoal          Int?     @map("new_customers_goal")
  customerPositivationGoal  Decimal? @map("customer_positivation_goal") @db.Decimal(14, 4)
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.DateTime2
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller                    User     @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, sellerId, year, month])
  @@index([sellerId])
  @@map("seller_goals")
}

model SellerGoalReminder {
  tenantId Int      @map("tenant_id")
  sellerId Int      @map("seller_id")
  year     Int
  month    Int
  day      Int
  sentAt   DateTime @map("sent_at") @db.DateTime2
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller   User     @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, sellerId, year, month, day])
  @@index([sellerId])
  @@map("seller_goal_reminders")
}

model PushToken {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  userId     Int      @map("user_id")
  token      String   @unique @db.NVarChar(255)
  platform   String   @db.NVarChar(20)
  deviceName String?  @map("device_name") @db.NVarChar(191)
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.DateTime2
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime2
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, active])
  @@index([tenantId, active])
  @@map("push_tokens")
}

model Notification {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  userId           Int       @map("user_id")
  kind             String    @db.NVarChar(50)
  title            String    @db.NVarChar(191)
  body             String    @db.NVarChar(Max)
  route            String?   @db.NVarChar(191)
  data             String?   @db.NVarChar(Max)
  readAt           DateTime? @map("read_at") @db.DateTime2
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime2
  pushAttempts     Int       @default(0) @map("push_attempts")
  pushSentAt       DateTime? @map("push_sent_at") @db.DateTime2
  pushClaimedUntil DateTime? @map("push_claimed_until") @db.DateTime2
  pushError        String?   @map("push_error") @db.NVarChar(1000)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, readAt, createdAt])
  @@index([pushSentAt, pushAttempts, createdAt])
  @@index([pushClaimedUntil])
  @@map("notifications")
}
