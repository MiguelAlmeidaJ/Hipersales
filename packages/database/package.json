{
  "name": "@hipersales/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "validate": "prisma validate",
    "format": "prisma format",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:sqlserver": "prisma validate --config prisma.sqlserver.config.ts",
    "generate:sqlserver": "prisma generate --config prisma.sqlserver.config.ts",
    "migrate:sqlserver:dev": "prisma migrate dev --config prisma.sqlserver.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3",
    "@prisma/adapter-mssql": "^7.10.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/mssql": "^9.1.8"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
