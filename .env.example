# Copie para .env; nao versionar credenciais reais
EVOLUTION_API_KEY=troque_por_uma_chave_aleatoria_forte
HYPERSALES_WHATSAPP_TOKEN=troque_por_outro_token_interno_forte
EVOLUTION_DB_PASSWORD=troque_por_uma_senha_forte
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_URL=http://127.0.0.1:8081
HYPERSALES_PUBLIC_URL=http://localhost:8000
HYPERSALES_COOKIE_SECURE=false
HYPERSALES_COOKIE_SAMESITE=Lax
HYPERSALES_SESSION_TTL_SECONDS=43200
# Usados somente se ainda nao existir nenhum administrador ativo.
HYPERSALES_BOOTSTRAP_ADMIN_NAME=Administrador
HYPERSALES_BOOTSTRAP_ADMIN_EMAIL=
HYPERSALES_BOOTSTRAP_ADMIN_PASSWORD=
# Origens adicionais separadas por virgula. Normalmente vazio em mesmo dominio.
HYPERSALES_ALLOWED_ORIGINS=http://localhost:3000
HYPERSALES_REPORT_TIMEZONE=America/Sao_Paulo
HIPERSALES_OUTBOX_WORKER=true
HIPERSALES_SCHEDULED_JOBS=true

# Banco principal da API. Use credenciais diferentes por ambiente.
HIPERSALES_DB_PASSWORD=troque_por_uma_senha_forte
DATABASE_URL=postgresql://hipersales:troque_por_uma_senha_forte@localhost:5432/hipersales
DATABASE_POOL_SIZE=10

# SQL Server do Hipersales em Docker (porta 14333 do host)
HIPERSALES_SQLSERVER_SA_PASSWORD=DEFINA_UMA_SENHA_FORTE_COM_COMPLEXIDADE
# Usar somente apos API/Prisma estarem migrados e o banco criado.
# SQLSERVER_DATABASE_URL=sqlserver://localhost:14333;database=hipersales;user=hipersales_app;password={SENHA};encrypt=true;trustServerCertificate=true
