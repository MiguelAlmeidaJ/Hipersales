# HiperSales — variáveis de runtime
# Copie para .env. Este arquivo é carregado pela API, Prisma, Web e Docker Compose.
# Nunca inclua a senha do sa aqui: a aplicação não precisa de acesso administrativo.

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3110
HYPERSALES_PUBLIC_URL=http://localhost:3110
HYPERSALES_ALLOWED_ORIGINS=http://localhost:3111
TRUST_PROXY=1

# SQL Server — login exclusivo da aplicação, sem db_owner/sysadmin
DATABASE_POOL_SIZE=10
# Use {senha} quando houver ponto e vírgula na senha.
SQLSERVER_DATABASE_URL=sqlserver://localhost:14333;database=hipersales;user=hipersales_app;password={SENHA_FORTE_EXCLUSIVA_DA_APLICACAO};encrypt=true;trustServerCertificate=true

# Sessão e segurança
HYPERSALES_SESSION_COOKIE=hypersales_session
HYPERSALES_SESSION_TTL_SECONDS=43200
HYPERSALES_COOKIE_SECURE=false
HYPERSALES_COOKIE_SAMESITE=Lax

# Administrador inicial — usado somente quando ainda não existe administrador ativo
HYPERSALES_BOOTSTRAP_ADMIN_NAME=Administrador
HYPERSALES_BOOTSTRAP_ADMIN_EMAIL=
HYPERSALES_BOOTSTRAP_ADMIN_PASSWORD=

# Operação
HYPERSALES_REPORT_TIMEZONE=America/Sao_Paulo
HIPERSALES_OUTBOX_WORKER=true
HIPERSALES_SCHEDULED_JOBS=true
SINTEGRA_API_KEY=

# Evolution API / WhatsApp
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=troque_por_uma_chave_aleatoria_forte
HYPERSALES_WHATSAPP_TOKEN=troque_por_outro_token_interno_forte

# Web (acesso interno do servidor Next.js à API)
HIPERSALES_API_ORIGIN=http://127.0.0.1:3110
