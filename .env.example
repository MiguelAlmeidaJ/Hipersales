# Configuração pública do app; não inserir segredos.
# API externa HiperSales v1. Sem porta explícita: o proxy HTTPS encaminha ao serviço interno.
EXPO_PUBLIC_API_URL=https://api.hipersalesweb.com.br/api/v1
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Dados locais para testar no navegador sem API e sem CORS.
# Login: demo / demo123
EXPO_PUBLIC_USE_MOCK_API=false
