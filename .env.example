# Copie para .env; nao versionar credenciais reais
EVOLUTION_API_KEY=troque_por_uma_chave_aleatoria_forte
EVOLUTION_DB_PASSWORD=troque_por_uma_senha_forte
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_URL=http://127.0.0.1:8081
HYPERSALES_PUBLIC_URL=http://localhost:8000
HYPERSALES_COOKIE_SECURE=false
HYPERSALES_COOKIE_SAMESITE=Lax
HYPERSALES_SESSION_TTL_SECONDS=43200
# Origens adicionais separadas por virgula. Normalmente vazio em mesmo dominio.
HYPERSALES_ALLOWED_ORIGINS=http://localhost:3000
HYPERSALES_REPORT_TIMEZONE=America/Sao_Paulo

# Temporario durante a migracao por dominio; nunca publique esta porta.
LEGACY_API_ORIGIN=http://127.0.0.1:8001
# Habilita, em conjunto, apenas as rotas que ja possuem implementacao Nest e testes.
# PDFs, settings, webhooks e workers continuam no legado ate o corte final.
HIPERSALES_NEST_MIGRATED_ROUTES=false

# PostgreSQL provisionado agora; migracao da API SQLite para PostgreSQL ainda exige cutover de codigo e dados.
HIPERSALES_DB_PASSWORD=troque_por_uma_senha_forte
DATABASE_URL=postgresql://hipersales:troque_por_uma_senha_forte@localhost:5432/hipersales
